// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "disable_ai": true,
  "inlay_hints": {
    "show_background": true,
    "enabled": true,
  },
  "gutter": {
    "breakpoints": true,
  },
  "ui_font_family": "MonoLisaText",
  "ui_font_size": 14,
  "ui_font_weight": 400,
  "buffer_font_family": "MonoLisaCode",
  "buffer_font_size": 14,
  "buffer_font_features": {
    "liga": false,
    "ss01": true,
    "ss08": true,
    "ss09": true,
    "ss10": true,
    "ss11": true,
    "ss14": true,
    "zero": true,
  },
  "buffer_font_weight": 500,
  "theme": {
    "mode": "system",
    "light": "One Dark",
    "dark": "One Dark",
  },
  "title_bar": {
    "show_branch_icon": true,
    "show_sign_in": false,
  },
  "preferred_line_length": 100,
  "languages": {
    "C++": {
      "wrap_guides": [100],
    },
  },
  "lsp": {
    "clangd": {
      "binary": {
        "path": "/usr/bin/clangd",
        "arguments": ["--header-insertion=never", "--completion-style=detailed"],
      },
    },
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic",
      },
    },
  },
}
